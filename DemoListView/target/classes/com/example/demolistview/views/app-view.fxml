<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demolistview.controllers.AppControllers">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <children>
        <Label text="Lista de Personas" style="-fx-font-weight: bold; -fx-font-size: 16px;" />

        <GridPane hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="284.0" minWidth="10.0" prefWidth="76.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="504.0" minWidth="10.0" prefWidth="504.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="Nombre:" />
                <Label text="Email:" GridPane.rowIndex="1" />
                <TextField fx:id="txtName" promptText="Ingrese el nombre" GridPane.columnIndex="1" />
                <TextField fx:id="txtEmail" promptText="ejemplo@correo.com" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </children>
        </GridPane>

        <HBox spacing="10">
            <children>
                <Button mnemonicParsing="false" onAction="#onAdd" text="Agregar Persona" />
                <Button mnemonicParsing="false" onAction="#onReload" text="Recargar Lista" />
            </children>
        </HBox>

        <ListView fx:id="listView" VBox.vgrow="ALWAYS" />

        <Label fx:id="lblMsg" />
    </children>
</VBox>